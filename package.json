{
  "name": "multihub-chat",
  "productName": "MultiHub Chat",
  "version": "1.2.0",
  "description": "Reúne até 3 sites de atendimento (WhatsApp Web, Chatwoot ou qualquer outro) em um único app desktop",
  "license": "MIT",
  "author": "MultiHub Chat contributors",
  "main": "main.js",
  "multihub": {
    "updateUrl": "https://github.com/Braido350/multihub-chat/releases/latest/download/latest.json"
  },
  "desktopName": "multihub-chat.desktop",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux AppImage",
    "build:win": "electron-builder --win nsis portable",
    "build:all": "electron-builder --linux AppImage --win nsis portable",
    "release": "node scripts/make-release.js",
    "test:updater": "node updater/test/run-updater-tests.js"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.multihub-chat",
    "productName": "MultiHub Chat",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "shell-preload.js",
      "sidebar.html",
      "error.html",
      "email/**/*",
      "!email/test/**",
      "settings/**/*",
      "updater/**/*",
      "!updater/test/**",
      "icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network",
      "icon": "build/icons",
      "artifactName": "MultiHubChat-${version}-linux-x86_64.AppImage",
      "executableName": "multihub-chat",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "artifactName": "MultiHubChat-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "MultiHubChat-${version}-win-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "MultiHubChat-${version}-win-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "htmlparser2": "^12.0.0",
    "imapflow": "^2.10.2",
    "libmime": "^5.6.4",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "sanitize-html": "^2.18.1"
  }
}
